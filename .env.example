OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# SQLite database location (defaults to data/gtm.db in the repo)
# DATABASE_URL=sqlite:////absolute/path/to/gtm.db

# Sender identity (must match the authorized Gmail account)
SENDER_NAME=Jane Doe
SENDER_EMAIL=jane@yourcompany.com

# Sending limits
DAILY_SEND_CAP=30

# Crawler politeness
CRAWL_DELAY_SECONDS=2.0
MAX_PAGES_PER_SITE=15
CRAWL_MAX_DEPTH=2
USER_AGENT=GTMResearchBot/0.1 (+mailto:jane@yourcompany.com)

# Gmail OAuth files
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
